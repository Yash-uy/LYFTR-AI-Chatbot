# Add at least two valid provider API keys, comma-separated. Never commit real keys.
LLM_API_KEYS=your_google_ai_studio_key_1,your_google_ai_studio_key_2
LLM_MODEL=gemini/gemini-2.0-flash
DATABASE_URL=sqlite:////data/app.db
ALLOWED_ORIGINS=http://localhost:3000
ENABLE_FAILURE_SIMULATION=true
DEFAULT_SYSTEM_PROMPT=You are a helpful, concise assistant.
CACHE_TTL_SECONDS=3600
# Used at frontend build time for Docker; change this to the public backend URL when deploying.
VITE_API_URL=http://localhost:8000
